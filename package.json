{
  "name": "fitness-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "node scripts/prepare-ocr.cjs && next dev",
    "build": "prisma generate && node scripts/prepare-ocr.cjs && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs",
    "test:postgres": "node --test tests/postgres-sync.cjs",
    "credentials:encrypt": "node --env-file=.env.local scripts/encrypt-credentials.cjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "@prisma/client": "^5.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.540.0",
    "mcp-handler": "^2.3.0",
    "next": "16.4.1",
    "next-auth": "^5.0.0-beta.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.2",
    "recharts": "^3.1.2",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^2.1.4",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^20",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.1",
    "postcss": "^8.5.6",
    "prisma": "^5.10.2",
    "react-test-renderer": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
